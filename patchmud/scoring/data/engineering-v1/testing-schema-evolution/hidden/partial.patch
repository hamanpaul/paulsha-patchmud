+def test_agent_replay_regression_exposes_current_ordering_bug():
+    state = {}
+    normalize(parse({"id": "agent-partial", "version": 2, "tenant": "a", "payload": {"n": 2}}), state)
+    normalize(parse({"id": "agent-partial", "version": 1, "tenant": "a", "payload": {"n": 1}}), state)
+    # This documents the intended invariant; the unpatched source currently fails it.
+    assert state["agent-partial"]["payload"] == {"n": 2}
