--- /dev/null
+++ b/tests/agent/test_parser_regression.py
@@ -0,0 +1,21 @@
+import pytest
+
+from src.parser import parse
+
+
+def test_agent_matrix_preserves_quotes_and_blank_optional_values():
+    assert parse('id,name,note\n7,"Chen, Li","said ""hi"""\n8,Bea,') == [
+        {"id": "7", "name": "Chen, Li", "note": 'said "hi"'},
+        {"id": "8", "name": "Bea", "note": ""},
+    ]
+
+
+def test_agent_matrix_keeps_header_and_row_errors_distinct():
+    with pytest.raises(ValueError, match="header"):
+        parse("id,id\n1,2")
+    with pytest.raises(ValueError, match="row width"):
+        parse("id,name\n1")
+
+
+def test_agent_matrix_ignores_blank_lines():
+    assert parse("id,name\n\n1,Ada\n") == [{"id": "1", "name": "Ada"}]
